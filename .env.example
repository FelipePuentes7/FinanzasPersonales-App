# Archivo de ejemplo de variables de entorno (NO incluir secretos reales aquí)
# Copie este archivo como .env para configuración local:
# Copy-Item .env.example .env

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000
DATABASE_PATH=data/finanzas.db
LOG_LEVEL=INFO

# Opcional: Clave de API para proveedor LLM externo (si se deja vacía, opera en modo offline determinista RNF-02)
LLM_API_KEY=
