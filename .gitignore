# Variables de entorno y secretos (RNF-03 de Seguridad)
.env
.env.*
!.env.example

# Entornos virtuales
venv/
.venv/
env/

# Caché de Python, linter y pruebas
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Base de datos local SQLite (RNF-02)
data/
*.db
*.sqlite3
